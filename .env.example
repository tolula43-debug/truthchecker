# TruthChecker Environment Configuration

# Flask Settings
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///truthchecker.db
# For PostgreSQL: postgresql://user:password@localhost:5432/truthchecker

# API Keys
GOOGLE_FACT_CHECK_API_KEY=your-google-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True

# CORS Settings (for frontend development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
